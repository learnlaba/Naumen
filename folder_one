<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Чек-лист: Стартовая форма анкеты NCC</title>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
        color: #333;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    .header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: #fff;
        padding: 30px;
        text-align: center;
    }

    .header h1 {
        font-size: 28px;
        margin-bottom: 10px;
    }

    .header p {
        opacity: 0.9;
        font-size: 15px;
    }

    .progress-container {
        background: #f0f2f5;
        padding: 20px 30px;
        border-bottom: 1px solid #e1e5eb;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-weight: 600;
        color: #555;
    }

    .progress-bar {
        width: 100%;
        height: 12px;
        background: #e1e5eb;
        border-radius: 6px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #11998e, #38ef7d);
        width: 0%;
        transition: width 0.4s ease;
        border-radius: 6px;
    }

    .content {
        padding: 30px;
    }

    .block {
        margin-bottom: 25px;
        border: 2px solid #e1e5eb;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .block.completed {
        border-color: #38ef7d;
        background: #f0fdf4;
    }

    .block-header {
        background: #f8f9fb;
        padding: 18px 20px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
    }

    .block-header:hover {
        background: #eef1f5;
    }

    .block-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        font-size: 16px;
        color: #1e3c72;
    }

    .block-number {
        background: #1e3c72;
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .block.completed .block-number {
        background: #38ef7d;
        color: #fff;
    }

    .block-toggle {
        font-size: 20px;
        color: #1e3c72;
        transition: transform 0.3s ease;
    }

    .block.open .block-toggle {
        transform: rotate(180deg);
    }

    .block-content {
        padding: 0 20px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease, padding 0.4s ease;
    }

    .block.open .block-content {
        padding: 20px;
        max-height: 2000px;
    }

    .block-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 15px;
        padding-left: 42px;
    }

    .checklist {
        list-style: none;
    }

    .checklist li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 12px;
        margin-bottom: 6px;
        border-radius: 8px;
        transition: background 0.2s ease;
    }

    .checklist li:hover {
        background: #f8f9fb;
    }

    .checklist input[type="checkbox"] {
        width: 20px;
        height: 20px;
        margin-top: 2px;
        cursor: pointer;
        accent-color: #1e3c72;
        flex-shrink: 0;
    }

    .checklist label {
        cursor: pointer;
        font-size: 14px;
        line-height: 1.5;
        flex: 1;
    }

    .checklist li.checked label {
        color: #888;
        text-decoration: line-through;
    }

    .footer {
        padding: 25px 30px;
        background: #f8f9fb;
        border-top: 1px solid #e1e5eb;
        display: flex;
        gap: 12px;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-reset {
        background: #ff6b6b;
        color: #fff;
    }

    .btn-reset:hover {
        background: #ee5a52;
        transform: translateY(-2px);
    }

    .btn-export {
        background: #1e3c72;
        color: #fff;
    }

    .btn-export:hover {
        background: #2a5298;
        transform: translateY(-2px);
    }

    .success-banner {
        display: none;
        background: linear-gradient(90deg, #11998e, #38ef7d);
        color: #fff;
        padding: 20px;
        text-align: center;
        font-weight: 600;
        font-size: 16px;
        animation: slideDown 0.5s ease;
    }

    .success-banner.show {
        display: block;
    }

    @keyframes slideDown {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .note {
        background: #fff8e1;
        border-left: 4px solid #ffc107;
        padding: 12px 16px;
        margin: 15px 0;
        font-size: 13px;
        color: #6d5a00;
        border-radius: 4px;
    }

    @media (max-width: 600px) {
        .header h1 { font-size: 22px; }
        .content { padding: 20px; }
        .block-title { font-size: 14px; }
    }
</style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>✅ Чек-лист стартовой формы анкеты</h1>
        <p>Naumen Contact Center · Проверка первой формы входящего проекта</p>
    </div>

    <div class="success-banner" id="successBanner">
        🎉 Отлично! Все пункты проверены — форма готова к работе!
    </div>

    <div class="progress-container">
        <div class="progress-label">
            <span>Прогресс проверки</span>
            <span id="progressText">0 / 0</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>

    <div class="content">

        <!-- Блок 1 -->
        <div class="block" data-block="1">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">1</span>
                    <span>Блок приветствия и первичного контакта</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Обеспечивает единый стандарт приветствия и профессиональное начало диалога.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b1_1"><label for="b1_1">Добавлен текстовый или форматированный элемент с приветствием</label></li>
                    <li><input type="checkbox" id="b1_2"><label for="b1_2">Приветствие учитывает время суток (утро/день/вечер) или универсально</label></li>
                    <li><input type="checkbox" id="b1_4"><label for="b1_4">Приветствие содержит представление оператора/компании</label></li>
                </ul>
            </div>
        </div>

        <!-- Блок 2 -->
        <div class="block" data-block="2">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">2</span>
                    <span>Блок проверки связи и технических сбоев</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Минимизирует время простоя оператора и корректно обрабатывает технические проблемы.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b2_2"><label for="b2_2">Есть РМ на случай тишины / клиент молчит</label></li>
                    <li><input type="checkbox" id="b2_3"><label for="b2_3">Есть РМ при плохой слышимости / прерывистой связи</label></li>
                    <li><input type="checkbox" id="b2_4"><label for="b2_4">Настроена инструкция при срабатывании автоответчика</label></li>
                    <li><input type="checkbox" id="b2_5"><label for="b2_5">Назначен результат вызова «Автоответчик» / «Недозвон»</label></li>
                    <li><input type="checkbox" id="b2_6"><label for="b2_6">Добавлена кнопка «Обрыв связи» для технических проблем</label></li>
                </ul>
            </div>
        </div>

        <!-- Блок 3 -->
        <div class="block" data-block="3">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">3</span>
                    <span>Блок обработки нестандартных ситуаций</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Снижает эмоциональную нагрузку на оператора и обеспечивает соблюдение стандартов.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b3_1"><label for="b3_1">Есть РМ для вопросов личного характера (вежливый отказ)</label></li>
                    <li><input type="checkbox" id="b3_2"><label for="b3_2">Есть алгоритм урегулирования конфликта (техника амортизации)</label></li>
                    <li><input type="checkbox" id="b3_3"><label for="b3_3">Есть РМ финального предупреждения при нецензурной лексике</label></li>
                    <li><input type="checkbox" id="b3_4"><label for="b3_4">Настроена кнопка перевода вызова на вышестоящее руководство (например, старший оператор, супервайзер или представитель от Заказчика и так далее)</label></li>
                    <li><input type="checkbox" id="b3_5"><label for="b3_5">Есть инструкция по фиксации инцидента в системе</label></li>
                </ul>
                <div class="note">
                    💡 <b>Совет:</b> используйте расширение «Суфлер» для подсказок новичкам в сложных ситуациях.
                </div>
            </div>
        </div>

        <!-- Блок 4 -->
        <div class="block" data-block="4">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">4</span>
                    <span>Блок управления ходом разговора</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Исключает негативную реакцию клиента при паузах и переводах.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b4_1"><label for="b4_1">Добавлена кнопка «Поставить/снять с удержания»</label></li>
                    <li><input type="checkbox" id="b4_2"><label for="b4_2">Есть РМ постановки на удержание («Подождите, пожалуйста…»)</label></li>
                    <li><input type="checkbox" id="b4_3"><label for="b4_3">Указано максимальное время удержания</label></li>
                    <li><input type="checkbox" id="b4_4"><label for="b4_4">Есть РМ перенаправления («Перевожу вас к специалисту…»)</label></li>
                </ul>
            </div>
        </div>

        <!-- Блок 5 -->
        <div class="block" data-block="5">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">5</span>
                    <span>Блок идентификации клиента и работы с данными</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Обеспечивает быструю идентификацию абонента и привязку обращения.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b5_1"><label for="b5_1">Добавлено поле для ввода ФИО клиента</label></li>
                    <li><input type="checkbox" id="b5_2"><label for="b5_2">Добавлено поле для ввода номера телефона клиента</label></li>
                    <li><input type="checkbox" id="b5_3"><label for="b5_3">Настроены атрибуты для ФИО и номера телефона</label></li>
                    <li><input type="checkbox" id="b5_4"><label for="b5_4">Применены валидаторы (формат номера, проверка ФИО)</label></li>
                    <li><input type="checkbox" id="b5_5"><label for="b5_5">Настроена интеграция с CRM (при наличии)</label></li>
                </ul>
            </div>
        </div>

        <!-- Блок 6 -->
        <div class="block" data-block="6">
            <div class="block-header">
                <div class="block-title">
                    <span class="block-number">6</span>
                    <span>Блок навигации и кнопок действий</span>
                </div>
                <span class="block-toggle">▼</span>
            </div>
            <div class="block-content">
                <p class="block-description">Обеспечивает логичный переход к следующим этапам или корректное завершение.</p>
                <ul class="checklist">
                    <li><input type="checkbox" id="b6_1"><label for="b6_1">Добавлена панель с кнопками действий</label></li>
                    <li><input type="checkbox" id="b6_2"><label for="b6_2">Настроена кнопка «Далее» (переход на следующую форму)</label></li>
                    <li><input type="checkbox" id="b6_3"><label for="b6_3">Настроена кнопка «Завершить» (для экстренного завершения)</label></li>
                    <li><input type="checkbox" id="b6_4"><label for="b6_4">Настроены кнопки «Недозвон» и «Обрыв связи»</label></li>
                    <li><input type="checkbox" id="b6_5"><label for="b6_5">Настроены условные переходы (при необходимости)</label></li>
                    <li><input type="checkbox" id="b6_6"><label for="b6_6">Проверена логика перехода на следующую форму</label></li>
                </ul>
            </div>
        </div>

    </div>

    <div class="footer">
        <button class="btn btn-reset" onclick="resetChecklist()">🔄 Сбросить всё</button>
        <button class="btn btn-export" onclick="exportResults()">📋 Копировать отчёт</button>
    </div>
</div>

<script>
    const STORAGE_KEY = 'ncc_start_form_checklist';

    // Инициализация
    document.addEventListener('DOMContentLoaded', () => {
        loadState();
        attachListeners();
        updateProgress();
    });

    function attachListeners() {
        // Переключение блоков
        document.querySelectorAll('.block-header').forEach(header => {
            header.addEventListener('click', () => {
                header.parentElement.classList.toggle('open');
            });
        });

        // Чекбоксы
        document.querySelectorAll('.checklist input[type="checkbox"]').forEach(cb => {
            cb.addEventListener('change', (e) => {
                e.target.parentElement.classList.toggle('checked', e.target.checked);
                saveState();
                updateProgress();
            });
        });
    }

    function updateProgress() {
        const all = document.querySelectorAll('.checklist input[type="checkbox"]');
        const checked = document.querySelectorAll('.checklist input[type="checkbox"]:checked');
        const total = all.length;
        const done = checked.length;

        document.getElementById('progressText').textContent = `${done} / ${total}`;
        const percent = total > 0 ? (done / total) * 100 : 0;
        document.getElementById('progressFill').style.width = percent + '%';

        // Проверка блоков
        document.querySelectorAll('.block').forEach(block => {
            const blockChecks = block.querySelectorAll('.checklist input[type="checkbox"]');
            const blockChecked = block.querySelectorAll('.checklist input[type="checkbox"]:checked');
            if (blockChecks.length > 0 && blockChecks.length === blockChecked.length) {
                block.classList.add('completed');
            } else {
                block.classList.remove('completed');
            }
        });

        // Баннер успеха
        const banner = document.getElementById('successBanner');
        if (total > 0 && done === total) {
            banner.classList.add('show');
        } else {
            banner.classList.remove('show');
        }
    }

    function saveState() {
        const state = {};
        document.querySelectorAll('.checklist input[type="checkbox"]').forEach(cb => {
            state[cb.id] = cb.checked;
        });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function loadState() {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return;
        try {
            const state = JSON.parse(saved);
            Object.keys(state).forEach(id => {
                const cb = document.getElementById(id);
                if (cb) {
                    cb.checked = state[id];
                    cb.parentElement.classList.toggle('checked', state[id]);
                }
            });
        } catch (e) {
            console.error('Ошибка загрузки состояния:', e);
        }
    }

    function resetChecklist() {
        if (!confirm('Сбросить все отметки? Прогресс будет потерян.')) return;
        document.querySelectorAll('.checklist input[type="checkbox"]').forEach(cb => {
            cb.checked = false;
            cb.parentElement.classList.remove('checked');
        });
        localStorage.removeItem(STORAGE_KEY);
        updateProgress();
    }

    function exportResults() {
        let report = '📋 ОТЧЁТ ПРОВЕРКИ СТАРТОВОЙ ФОРМЫ АНКЕТЫ\n';
        report += 'Naumen Contact Center\n';
        report += 'Дата: ' + new Date().toLocaleString('ru-RU') + '\n';
        report += '═'.repeat(50) + '\n\n';

        const all = document.querySelectorAll('.checklist input[type="checkbox"]');
        const checked = document.querySelectorAll('.checklist input[type="checkbox"]:checked');

        document.querySelectorAll('.block').forEach((block, idx) => {
            const title = block.querySelector('.block-title span:last-child').textContent;
            const items = block.querySelectorAll('.checklist li');
            const checkedInBlock = block.querySelectorAll('.checklist input[type="checkbox"]:checked').length;
            const totalInBlock = items.length;

            report += `${idx + 1}. ${title} [${checkedInBlock}/${totalInBlock}]\n`;
            items.forEach(li => {
                const cb = li.querySelector('input[type="checkbox"]');
                const label = li.querySelector('label').textContent;
                const mark = cb.checked ? '✅' : '⬜';
                report += `   ${mark} ${label}\n`;
            });
            report += '\n';
        });

        report += '═'.repeat(50) + '\n';
        report += `ИТОГО: ${checked.length} / ${all.length} (${Math.round(checked.length/all.length*100)}%)\n`;

        navigator.clipboard.writeText(report).then(() => {
            alert('✅ Отчёт скопирован в буфер обмена!\nМожете вставить его в чат или документ.');
        }).catch(() => {
            // Fallback
            const ta = document.createElement('textarea');
            ta.value = report;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            alert('✅ Отчёт скопирован!');
        });
    }
</script>

</body>
</html>
